# Backend (stesso contratto usato da lucaterribili-next)
NEXT_PUBLIC_ENDPOINT=http://localhost:8080
NEXT_PUBLIC_API_KEY=
# Deve corrispondere al "name" nella tabella domains del backend
NEXT_PUBLIC_DOMAIN=programmato.it
NEXT_PUBLIC_SITE_URL=https://programmato.it
NEXT_PUBLIC_MEDIA_BASE_URL=https://fridaymedia.s3.eu-west-par.io.cloud.ovh.net

# Domini aggregati in home, separati da virgola (devono corrispondere al DB).
# Dev:  PORTAL_DOMAINS=lucaterribili.loc,ai.programmato.loc
# Prod: PORTAL_DOMAINS=lucaterribili.it,ai.programmato.it
PORTAL_DOMAINS=lucaterribili.it,ai.programmato.it
